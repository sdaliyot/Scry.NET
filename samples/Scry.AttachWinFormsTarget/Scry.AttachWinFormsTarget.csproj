<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The point of this sample is what it does NOT contain: no ProjectReference or PackageReference
    to any Scry assembly. It is the only way to prove attach mode actually attaches to an
    unmodified process rather than relying on host cooperation, so do not add one. Mirrors
    Scry.AttachWpfTarget, but for the WinForms adapter.

    .NET Framework only, because the FX path (ExecuteInDefaultAppDomain) is the one that motivated
    attach mode and the one the real target runs on.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(ScryNetFrameworkTarget)</TargetFramework>
    <AssemblyName>Scry.AttachWinFormsTarget</AssemblyName>
    <RootNamespace>Scry.AttachWinFormsTarget</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Overridable, so the same sample can be built x86 to exercise a 32-bit attach. -->
    <PlatformTarget Condition="'$(PlatformTarget)' == ''">x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

</Project>
