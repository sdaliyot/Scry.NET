<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(ScryLibraryTargetFrameworks)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == '$(ScryNetFrameworkTarget)' and '$(PlatformTarget)' == 'x86'">
    <DefineConstants>$(DefineConstants);SCRY_EXPECT_X86</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == '$(ScryNetFrameworkTarget)' and '$(PlatformTarget)' == 'x64'">
    <DefineConstants>$(DefineConstants);SCRY_EXPECT_X64</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>


  <ItemGroup>
    <ProjectReference Include="..\..\src\Scry.Contracts\Scry.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Scry.Runtime\Scry.Runtime.csproj" />
    <ProjectReference Include="..\..\src\Scry.Sdk\Scry.Sdk.csproj" />
    <ProjectReference Include="..\..\src\Scry.Injector\Scry.Injector.csproj"
                      Condition="'$(TargetFramework)' == '$(ScryModernTargetFramework)'" />
    <ProjectReference Include="..\..\src\Scry.Cli\Scry.Cli.csproj"
                      ReferenceOutputAssembly="false"
                      Condition="'$(TargetFramework)' == '$(ScryModernTargetFramework)'" />
    <ProjectReference Include="..\..\samples\Scry.SampleHost\Scry.SampleHost.csproj" ReferenceOutputAssembly="false" />
    <!-- Modern-TFM only: these samples are not multi-targeted, so a net472 leg cannot reference them. -->
    <ProjectReference Include="..\..\samples\Scry.SampleWorker\Scry.SampleWorker.csproj"
                      ReferenceOutputAssembly="false"
                      Condition="'$(TargetFramework)' == '$(ScryModernTargetFramework)'" />
    <ProjectReference Include="..\..\samples\Scry.AttachTarget\Scry.AttachTarget.csproj"
                      ReferenceOutputAssembly="false"
                      Condition="'$(TargetFramework)' == '$(ScryModernTargetFramework)'" />
  </ItemGroup>

  <!--
    These samples are launched as separate processes by SampleIntegrationTests and
    AttachIntegrationTests rather than referenced, so they are built through an MSBuild task
    instead of a ProjectReference. Scry.AttachWpfTarget in particular must not be referenced:
    the point of it is that it has no Scry reference at all.

    RemoveProperties="TargetFramework" is load-bearing: the MSBuild task otherwise inherits this
    project's current global TargetFramework, so the net472 inner build would try to build the
    net9.0-windows samples as net472 and fail with NETSDK1136 (and the modern leg would try to
    build the net472-only attach target as net9.0). The target is also scoped to the modern leg so
    the samples are not built twice, once per inner build.
  -->
  <Target Name="BuildDesktopSamples"
          BeforeTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(TargetFramework)' == '$(ScryModernTargetFramework)'">
    <MSBuild
      Projects="..\..\samples\Scry.SampleWpf\Scry.SampleWpf.csproj;..\..\samples\Scry.SampleWinForms\Scry.SampleWinForms.csproj;..\..\samples\Scry.AttachWpfTarget\Scry.AttachWpfTarget.csproj"
      Targets="Build"
      BuildInParallel="true"
      RemoveProperties="TargetFramework"
      Properties="Configuration=$(Configuration)" />
  </Target>

</Project>
