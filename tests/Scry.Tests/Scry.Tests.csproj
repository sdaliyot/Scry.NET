<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(ScryLibraryTargetFrameworks)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == '$(ScryNetFrameworkTarget)' and '$(PlatformTarget)' == 'x86'">
    <DefineConstants>$(DefineConstants);SCRY_EXPECT_X86</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == '$(ScryNetFrameworkTarget)' and '$(PlatformTarget)' == 'x64'">
    <DefineConstants>$(DefineConstants);SCRY_EXPECT_X64</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>


  <ItemGroup>
    <ProjectReference Include="..\..\src\Scry.Contracts\Scry.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Scry.Runtime\Scry.Runtime.csproj" />
    <ProjectReference Include="..\..\src\Scry.Sdk\Scry.Sdk.csproj" />
    <ProjectReference Include="..\..\src\Scry.Cli\Scry.Cli.csproj"
                      ReferenceOutputAssembly="false"
                      Condition="'$(TargetFramework)' == '$(ScryModernTargetFramework)'" />
    <ProjectReference Include="..\..\samples\Scry.SampleHost\Scry.SampleHost.csproj" ReferenceOutputAssembly="false" />
    <!-- Modern-TFM only: this sample is not multi-targeted, so a net472 leg cannot reference it. -->
    <ProjectReference Include="..\..\samples\Scry.SampleWorker\Scry.SampleWorker.csproj"
                      ReferenceOutputAssembly="false"
                      Condition="'$(TargetFramework)' == '$(ScryModernTargetFramework)'" />
  </ItemGroup>

  <!--
    The desktop samples are launched as separate processes by SampleIntegrationTests rather than
    referenced, so they are built through an MSBuild task instead of a ProjectReference.

    RemoveProperties="TargetFramework" is load-bearing: the MSBuild task otherwise inherits this
    project's current global TargetFramework, so the net472 inner build would try to build these
    net9.0-windows samples as net472 and fail with NETSDK1136. The target is also scoped to the
    modern leg so the samples are not built twice, once per inner build.
  -->
  <Target Name="BuildDesktopSamples"
          BeforeTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(TargetFramework)' == '$(ScryModernTargetFramework)'">
    <MSBuild
      Projects="..\..\samples\Scry.SampleWpf\Scry.SampleWpf.csproj;..\..\samples\Scry.SampleWinForms\Scry.SampleWinForms.csproj"
      Targets="Build"
      BuildInParallel="true"
      RemoveProperties="TargetFramework"
      Properties="Configuration=$(Configuration)" />
  </Target>

</Project>
