#include <windows.h>
#include "Version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION    SCRY_FILEVERSION
PRODUCTVERSION SCRY_FILEVERSION
FILEFLAGSMASK  0x3fL
#ifdef _DEBUG
FILEFLAGS      VS_FF_DEBUG
#else
FILEFLAGS      0x0L
#endif
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_DLL
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Shahar Daliyot"
            VALUE "FileDescription",  "Scry.NET Native Injection Bootstrap"
            VALUE "FileVersion",      SCRY_FILEVERSION_STR
            VALUE "InternalName",     "Scry.Injector.Native.dll"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Shahar Daliyot"
            VALUE "OriginalFilename", "Scry.Injector.Native.dll"
            VALUE "ProductName",      "Scry.NET"
            VALUE "ProductVersion",   SCRY_PRODUCTVERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
