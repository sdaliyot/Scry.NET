<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ScryModernTargetFramework>net9.0</ScryModernTargetFramework>
    <ScryModernWindowsTargetFramework>net9.0-windows</ScryModernWindowsTargetFramework>
    <ScryNetFrameworkTarget>net472</ScryNetFrameworkTarget>
    <ScryLibraryTargetFrameworks>$(ScryModernTargetFramework);$(ScryNetFrameworkTarget)</ScryLibraryTargetFrameworks>
    <ScryDesktopTargetFrameworks>$(ScryModernWindowsTargetFramework);$(ScryNetFrameworkTarget)</ScryDesktopTargetFrameworks>
    <SystemTextJsonVersion>9.0.11</SystemTextJsonVersion>
    <BclAsyncInterfacesVersion>9.0.11</BclAsyncInterfacesVersion>
    <TasksExtensionsVersion>4.5.4</TasksExtensionsVersion>
    <NetFrameworkReferenceAssembliesVersion>1.0.3</NetFrameworkReferenceAssembliesVersion>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == '$(ScryNetFrameworkTarget)'">
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == '$(ScryNetFrameworkTarget)'">
    <Compile Include="$(MSBuildThisFileDirectory)src\Shared\NetFrameworkCompatibility.cs"
             Link="Compatibility\NetFrameworkCompatibility.cs" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472"
                      Version="$(NetFrameworkReferenceAssembliesVersion)"
                      PrivateAssets="all" />
  </ItemGroup>


  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md"
          Pack="true"
          PackagePath="\"
          Visible="false" />
  </ItemGroup>
</Project>
