<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Scry.Contracts\Scry.Contracts.csproj" />
    <ProjectReference Include="..\Scry.Injector\Scry.Injector.csproj" />
    <ProjectReference Include="..\Scry.Client\Scry.Client.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(ScryModernTargetFramework)</TargetFramework>
    <AssemblyName>scry</AssemblyName>
    <ApplicationIcon>..\..\assets\Scry.NET-logo.ico</ApplicationIcon>
    <!--
      PackAsTool/PackageId are left in place (a `dotnet pack` still works locally/offline), but the
      CLI is not pushed to nuget.org: `dotnet pack` does not run the publish-time staging that puts
      payload/native beside the tool, so a `dotnet tool install`-ed copy could not attach. Distributed
      instead as a self-contained zip via GitHub Releases, built with `dotnet publish` (which does
      stage everything correctly).
    -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>scry</ToolCommandName>
    <PackageId>Scry.Cli</PackageId>
  </PropertyGroup>

  <!--
    StageInjectorComponents below copies what Scry.Injector's own AfterTargets="Build" target
    (BuildInjectionPayloads) places in the injector's output. Referencing the injector does not
    guarantee that target has finished: when the solution build has already started the injector,
    the reference request is satisfied as soon as the injector's Build target completes - before
    that after-build target - so the copy below could find no native helper and an incomplete
    payload, and a build that reported success produced a CLI that fails every attach with
    missing_native_helper. Requesting both targets explicitly makes this wait for (or run) the
    staging, whichever got there first. Reproduced by delaying BuildInjectionPayloads while the
    CLI's reference request arrives mid-way; it showed up in CI as ten failing attach tests.
  -->
  <Target Name="BuildInjectorComponents">
    <MSBuild Projects="../Scry.Injector/Scry.Injector.csproj"
             Targets="Build;BuildInjectionPayloads"
             Properties="TargetFramework=$(ScryModernTargetFramework)" />
  </Target>

  <Target Name="StageInjectorComponents" AfterTargets="Build" DependsOnTargets="BuildInjectorComponents">
    <ItemGroup>
      <InjectorPayload Include="..\Scry.Injector\bin\$(Configuration)\$(ScryModernTargetFramework)\payload\**\*" />
      <InjectorNative Include="..\Scry.Injector\bin\$(Configuration)\$(ScryModernTargetFramework)\native\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(InjectorPayload)"
          DestinationFiles="@(InjectorPayload->'$(TargetDir)payload\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(InjectorNative)"
          DestinationFiles="@(InjectorNative->'$(TargetDir)native\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!--
    Without this, `dotnet publish` produces a scry.exe that fails every attach with
    missing_native_helper: StageInjectorComponents above is AfterTargets="Build" and copies into
    $(TargetDir), which publish never reads from. This is the direct transcription of
    Scry.Injector.csproj's StageInjectionPayloadsForPublish for the same reason.
  -->
  <Target Name="StageInjectorComponentsForPublish" AfterTargets="Publish">
    <ItemGroup>
      <StagedNative Include="$(TargetDir)native\**\*" />
      <StagedPayload Include="$(TargetDir)payload\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(StagedNative)"
          DestinationFiles="@(StagedNative->'$(PublishDir)native\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(StagedPayload)"
          DestinationFiles="@(StagedPayload->'$(PublishDir)payload\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
