<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Scry.Contracts\Scry.Contracts.csproj" />
    <ProjectReference Include="..\Scry.Injector\Scry.Injector.csproj" />
    <ProjectReference Include="..\Scry.Sdk\Scry.Sdk.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(ScryModernTargetFramework)</TargetFramework>
    <AssemblyName>scry</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>scry</ToolCommandName>
    <PackageId>Scry.Cli</PackageId>
  </PropertyGroup>

  <Target Name="StageInjectorComponents" AfterTargets="Build">
    <ItemGroup>
      <InjectorPayload Include="..\Scry.Injector\bin\$(Configuration)\$(ScryModernTargetFramework)\payload\**\*" />
      <InjectorNative Include="..\Scry.Injector\bin\$(Configuration)\$(ScryModernTargetFramework)\native\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(InjectorPayload)"
          DestinationFiles="@(InjectorPayload->'$(TargetDir)payload\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(InjectorNative)"
          DestinationFiles="@(InjectorNative->'$(TargetDir)native\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
